class ReportExcelExporter
  def self.generate: (Report report) -> String
  private
  def self.build_styles: (untyped workbook) -> untyped
  def self.add_data_sheet: (untyped workbook, untyped name, untyped columns, untyped rows, untyped styles) -> untyped
  def self.write_data_sheet: (untyped workbook, untyped name, untyped columns, untyped rows, untyped styles) -> untyped
  def self.typed_cell: (untyped value, untyped type) -> [untyped, Symbol]
  def self.add_summary_sheet: (untyped workbook, untyped report, untyped result, untyped styles) -> untyped
end
