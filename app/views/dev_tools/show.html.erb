<div class="space-y-4">
  <section>
    <h2 class="text-base font-semibold text-body">Offline mode</h2>
    <p class="mt-1 text-sm text-muted">
      Test offline behaviour and sync state.
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <%= link_to "Open Offline Mode", offline_path,
          class: "inline-flex min-h-7.5 items-center justify-center bg-accent px-2.5 py-1 text-sm font-semibold text-[color:var(--color-page)] hover:bg-[var(--color-accent-hover)]" %>
      <button type="button"
              data-controller="fake-offline"
              data-action="click->fake-offline#toggle"
              class="inline-flex min-h-7.5 items-center justify-center border border-theme bg-surface px-2.5 py-1 text-sm font-semibold text-body hover:bg-(--color-border)">
        <span data-fake-offline-target="label">Fake offline</span>
      </button>
    </div>
    <div class="mt-2 flex items-center gap-1.5 rounded-md border border-theme bg-surface px-2 py-1.5" data-controller="offline-status" style="max-width: fit-content;">
      <svg class="h-3 w-3 shrink-0 text-muted opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728M15.536 8.464a5 5 0 010 7.072M12 12h.01M8.464 15.536a5 5 0 010-7.072M5.636 18.364a9 9 0 010-12.728"/>
      </svg>
      <span data-offline-status-target="label" class="text-xs text-muted">Loading…</span>
      <button type="button"
              data-action="click->offline-status#sync"
              data-offline-status-target="button"
              class="flex h-4 w-4 shrink-0 items-center justify-center rounded text-muted hover:text-body disabled:opacity-40"
              aria-label="Sync offline data">
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
      </button>
    </div>
  </section>

  <section>
    <h2 class="text-base font-semibold text-body">Background jobs</h2>
    <p class="mt-1 text-sm text-muted">
      View Solid Queue jobs, retry failed jobs, and inspect what&apos;s being processed.
    </p>
    <div class="mt-2 flex flex-wrap gap-2">
      <%= link_to "Open Mission Control Jobs", "/jobs", target: "_blank", rel: "noopener",
          class: "inline-flex min-h-7.5 items-center justify-center bg-accent px-2.5 py-1 text-sm font-semibold text-[color:var(--color-page)] hover:bg-[var(--color-accent-hover)]" %>
      <%= button_to "Enqueue test job", dev_tools_test_job_path, method: :post,
          class: "inline-flex min-h-7.5 items-center justify-center border border-theme bg-surface px-2.5 py-1 text-sm font-semibold text-body hover:bg-(--color-border)" %>
    </div>
    <p class="mt-1 text-xs text-muted">
      Click &ldquo;Enqueue test job&rdquo; then open Mission Control to see the job appear and process.
    </p>
  </section>

  <section>
    <h2 class="text-base font-semibold text-body">Search index</h2>
    <p class="mt-1 text-sm text-muted">
      Rebuild the PgSearch multisearch index for all searchable models.
      Useful after bulk imports, manual database changes, or if search results seem stale.
    </p>
    <div class="mt-2 flex flex-wrap gap-2">
      <%= button_to "Reindex all models", dev_tools_reindex_search_path, method: :post,
          class: "inline-flex min-h-7.5 items-center justify-center border border-theme bg-surface px-2.5 py-1 text-sm font-semibold text-body hover:bg-(--color-border)" %>
    </div>
    <p class="mt-1 text-xs text-muted">
      Rebuilds: Product, Service, Customer, User, Category, Supplier, TaxCode.
    </p>
  </section>

  <section>
    <h2 class="text-base font-semibold text-body">UI components</h2>
    <p class="mt-1 text-sm text-muted">
      Standard components in each theme. Use the theme switcher above to preview light, dark, and dim.
    </p>

    <div class="mt-2 space-y-4">
      <div class="border border-theme bg-surface p-2.5">
        <h3 class="text-sm font-medium text-body">Buttons</h3>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" class="inline-flex min-h-7.5 items-center justify-center bg-accent px-2.5 py-1 text-sm font-semibold text-(--color-page) hover:bg-(--color-accent-hover)">
            Primary
          </button>
          <button type="button" class="inline-flex min-h-7.5 items-center justify-center border border-theme bg-surface px-2.5 py-1 text-sm font-semibold text-body hover:bg-(--color-border)">
            Secondary
          </button>
          <button type="button" class="text-sm font-medium text-(--color-error-text) hover:opacity-80">
            Danger link
          </button>
        </div>
      </div>

      <div class="border border-theme bg-surface p-2.5">
        <h3 class="text-sm font-medium text-body">Form inputs</h3>
        <div class="mt-2 space-y-2 max-w-md">
          <div>
            <label class="block text-sm font-medium text-body">Text field</label>
            <input type="text" placeholder="Placeholder" class="input-field mt-1 block w-full min-h-8.5" autocomplete="off">
          </div>
          <div>
            <label class="block text-sm font-medium text-body">Textarea</label>
            <textarea rows="3" placeholder="Placeholder" class="input-field mt-1 block w-full"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-body">Select</label>
            <select class="input-field mt-1 block w-full min-h-8.5">
              <option>Option 1</option>
              <option>Option 2</option>
            </select>
          </div>
        </div>
      </div>

      <div class="border border-theme bg-surface p-2.5">
        <h3 class="text-sm font-medium text-body">Cards and alerts</h3>
        <div class="mt-2 space-y-2">
          <div class="border border-(--color-success-border) bg-(--color-success-bg) px-2 py-1.5">
            <p class="text-sm font-semibold text-(--color-success-text)">Success message</p>
          </div>
          <div class="border border-(--color-error-border) bg-(--color-error-bg) px-2 py-1.5">
            <p class="text-sm font-semibold text-(--color-error-text)">Error message</p>
          </div>
        </div>
      </div>

      <div class="border border-theme bg-surface p-2.5">
        <h3 class="text-sm font-medium text-body">Typography</h3>
        <div class="mt-2 space-y-1">
          <p class="text-lg font-semibold text-body">Heading</p>
          <p class="text-sm text-body">Body text</p>
          <p class="text-xs text-muted">Muted helper text</p>
        </div>
      </div>

      <div class="border border-theme bg-surface p-2.5">
        <h3 class="text-sm font-medium text-body">Table</h3>
        <div class="mt-2 overflow-x-auto border border-theme">
          <table class="min-w-full divide-y divide-(--color-border)">
            <thead class="bg-surface-alt">
              <tr>
                <th class="px-2 py-1 text-left text-xs font-medium uppercase tracking-wider text-muted">Column A</th>
                <th class="px-2 py-1 text-left text-xs font-medium uppercase tracking-wider text-muted">Column B</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-(--color-border) bg-surface">
              <tr>
                <td class="px-2 py-1.5 text-sm font-medium text-body">Row 1</td>
                <td class="px-2 py-1.5 text-sm text-body">Value</td>
              </tr>
              <tr>
                <td class="px-2 py-1.5 text-sm font-medium text-body">Row 2</td>
                <td class="px-2 py-1.5 text-sm text-body">Value</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>
