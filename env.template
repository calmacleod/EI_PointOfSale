# Copy this file to .env and fill in your values.
# cp env.template .env

# Environment (development, test, or production)
RAILS_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL: disable GSSAPI so the pg gem can connect locally
# Required when running Solid Queue / bin/dev
PGGSSENCMODE=disable

# Mapbox Address Autofill (Admin settings → Store information)
# Get a free token at https://account.mapbox.com/
# Without this, the address field works as a normal text input.
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Garage/S3-compatible object storage for Active Storage
GARAGE_ACCESS_KEY=garageadmin
GARAGE_SECRET_KEY=garageadmin
GARAGE_ENDPOINT=http://localhost:3900

# Google Drive backups (OAuth 2.0 — works with personal Gmail accounts)
# 1. Create a Google Cloud project and enable the Drive API
# 2. Create OAuth 2.0 Web application credentials
# 3. Add http://localhost:3000/admin/backups/oauth_callback as a redirect URI
# 4. Visit Admin > Backups and click "Connect Google Drive" to authorize
# See docs/google-drive-backups.md for full setup instructions.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
# GOOGLE_DRIVE_BACKUP_FOLDER_ID=your_folder_id
# GOOGLE_DRIVE_TOKEN_PATH=storage/google_oauth_token.json

# SMTP for password reset emails in production
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# MAILER_FROM=no-reply@example.com

# Web push notifications (optional for the associate pilot)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_CONTACT=mailto:admin@example.com

# Development seed credentials (optional)
# Used by db/seeds and shown on the sign-in page in development
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_PASSWORD=password123!
# DEV_ADMIN_NAME=Admin
